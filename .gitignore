# ROM images: original dumps and generated builds are never committed
*.nes
*.NES
*.fds
*.unf
*.zip

# Per-game local folders: private/ = original ROMs and other private inputs,
# build/ = generated ROMs and build artefacts
private/
build/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# IDE / local tooling (assistant and agent configuration stays local)
.idea/
.mcp.json
.claude/
.agents/
skills-lock.json

# Mesen debugger artefacts
*.mss
*.mst
*.cdl
